    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const retorno = $input.first().json;\nlet texto = '';\nif (retorno.error || retorno.result?.isError) {\n  texto = 'Não foi possível consultar esse recurso. Verifique as permissões da sua conta.';\n} else {\n  const blocos = retorno.result?.content || [];\n  const textos = blocos.filter(x => x.type === 'text').map(x => String(x.text));\n  texto = textos.join('\\n');\n  try {\n    const json = JSON.parse(texto);\n    if ($('Ler mensagem').first().json.ferramenta === 'consultar_saldo' && json.saldo !== undefined) {\n      texto = 'Saldo disponível: ' + Number(json.saldo).toLocaleString('pt-BR', {style:'currency',currency:'BRL'});\n    } else {\n      texto = JSON.stringify(json, null, 2);\n    }\n  } catch {}\n}\nreturn [{json:{chatId:$('Ler mensagem').first().json.chatId,text:texto.slice(0,3500) || 'Não há dados disponíveis para esta consulta.'}}];"
      },
