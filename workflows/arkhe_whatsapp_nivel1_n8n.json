    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const evento = $input.first().json.body || $input.first().json;\nconst p = evento.payload || {};\nconst chatId = String(p.from || '');\nif (evento.event !== 'message' || evento.session !== 'arkhe' || p.fromMe === true || p.hasMedia === true || !chatId.endsWith('@c.us')) return [];\nconst texto = String(p.body || '').trim().slice(0, 300);\nif (!texto) return [];\nconst entrada = texto.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase();\nconst codigo = /^\\d{8}$/.test(texto) ? texto : '';\nlet ferramenta = '';\nconst comandos = [\n  [/\\b(saldo)\\b/, 'consultar_saldo'],\n  [/\\b(extrato|movimentacoes)\\b/, 'consultar_extrato'],\n  [/\\b(dda)\\b/, 'consultar_dda'],\n  [/\\b(boletos|boleto)\\b/, 'consultar_boletos'],\n  [/\\b(faturas|fatura)\\b/, 'consultar_faturas'],\n  [/\\b(limites|limite)\\b/, 'consultar_limites'],\n  [/\\b(chaves? pix|pix chaves?)\\b/, 'listar_chaves_pix'],\n  [/\\b(funcionarios|funcionario)\\b/, 'listar_funcionarios'],\n  [/\\b(folhas|folha)\\b/, 'consultar_folhas'],\n  [/\\b(conta|dados bancarios)\\b/, 'consultar_dados_conta'],\n];\nfor (const [regra, nome] of comandos) if (regra.test(entrada)) { ferramenta = nome; break; }\nconst rota = codigo ? 'codigo' : /^(sair|encerrar|desconectar)$/.test(entrada) ? 'sair' : ferramenta ? 'consulta' : 'ajuda';\nreturn [{json:{telefone:chatId.split('@')[0],chatId,texto,rota,codigo,ferramenta}}];"
      },
